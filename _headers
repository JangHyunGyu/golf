# Keep Cloudflare preview and default Pages domains out of search results.
https://golf-3xe.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:version.golf-3xe.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# Localized landing hubs duplicate the analyzer intent and must not compete
# with the indexable analysis pages.
/index-en*
  X-Robots-Tag: noindex, follow

/index-jp*
  X-Robots-Tag: noindex, follow

# Repository and build inputs are public assets in the current root deployment,
# but they are not search content.
/seo/_*
  X-Robots-Tag: noindex, nofollow

/package.json
  X-Robots-Tag: noindex, nofollow

/package-lock.json
  X-Robots-Tag: noindex, nofollow

/validate.js
  X-Robots-Tag: noindex, nofollow

/vite.config.js
  X-Robots-Tag: noindex, nofollow
